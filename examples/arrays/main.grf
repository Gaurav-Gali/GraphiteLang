import grf.io;

// Stage 6 arrays: typed literals, indexing, slicing, methods,
// destructuring, and iteration. Arrays are copied, not aliased.

int[] edited(int[] items) {
    items[0] = 99;
    return items;
}

void show(str label, int[] items) {
    io.print(label);
    io.print(" ");
    io.println(items);
}

void main() {
    io.println("literals");
    int[] numbers = [10, 20, 30, 40, 50];
    int64[] same = numbers;
    str[] names = ["Ada", "Linus"];
    flt[] measurements = [1.5, 2.0];
    int32[] widths = [6, 7];
    int16[] depths = [8];
    uint[] counts = [2, 3];
    uint32[] tickets = [4];
    uint16[] seeds = [3];
    bln[] flags = [true, false];
    chr[] letters = [chr("A"), chr("B")];
    int[] empty = [];
    int[][] matrix = [[1, 2], [3, 4]];
    int[][][] cube = [[[1], [2]], [[3], [4]]];
    int[][] blank = [];
    int[][] rows = [[], [8]];
    show("numbers", numbers);
    io.println(names[1]);
    io.println(measurements[0]);
    io.println(widths[1]);
    io.println(depths[0]);
    io.println(counts[1]);
    io.println(tickets[0]);
    io.println(seeds[0]);
    io.println(flags[0]);
    io.println(letters[0]);
    io.println(lengthOf(empty));
    io.println(matrix[0][1]);
    io.println(cube[1][0][0]);
    io.println(lengthOf(blank));
    io.println(rows[1][0]);
    io.println(same[0]);

    io.println("index");
    int32 slot = 1;
    uint16 fromEnd = 1;
    io.println(numbers[0]);
    io.println(numbers[4]);
    io.println(numbers[-1]);
    io.println(numbers[-5]);
    io.println(numbers[slot]);
    io.println(numbers[fromEnd]);
    io.println(numbers.get(0));
    io.println(numbers.get(-2));
    numbers[0] = 11;
    numbers[-1] = 55;
    numbers.set(slot, 21);
    show("written", numbers);

    io.println("slice");
    int[] fresh = [10, 20, 30, 40, 50];
    show("prefix", fresh[:3]);
    show("middle", fresh[1:4]);
    show("suffix", fresh[2:]);
    show("copy", fresh[:]);
    show("step", fresh[::2]);
    show("reverse", fresh[::-1]);
    show("back", fresh[4:0:-1]);
    show("drop-last", fresh[:-1]);
    show("tail", fresh[-3:]);
    int[] independent = fresh[:];
    independent[0] = 99;
    show("fresh", fresh);
    show("independent", independent);

    io.println("assign");
    int[] editedRange = [10, 20, 30, 40, 50];
    editedRange[1:3] = [200, 300];
    show("replace", editedRange);
    editedRange[1:2] = [7, 8, 9];
    show("grow", editedRange);
    editedRange[1:4] = [];
    show("delete", editedRange);
    int[] stepped = [1, 2, 3, 4, 5];
    stepped[::2] = [10, 30, 50];
    show("stepped", stepped);
    int[] reversed = [1, 2, 3, 4, 5];
    reversed[::-1] = [9, 8, 7, 6, 5];
    show("reversed", reversed);
    int[] whole = [1, 2, 3];
    whole[:] = whole[:];
    show("whole", whole);

    io.println("methods");
    int[] items = [10, 20, 30];
    items.push(60);
    items.insert(0, 5);
    items.insert(lengthOf(items), 70);
    items.insert(-1, 65);
    items.remove(-1);
    items.remove(0);
    show("items", items);
    io.println(items.length());
    io.println(lengthOf(items));

    io.println("const");
    const int[] fixed = [10, 20, 30];
    int last = fixed[-1];
    int[] fromConst = fixed[:];
    fromConst[0] = 1;
    io.println(last);
    io.println(lengthOf(fixed));
    io.println(fixed.length());
    io.println(fixed.get(0));
    show("fixed", fixed);
    show("from-const", fromConst);

    io.println("copy");
    int[] original = [1, 2, 3];
    int[] local = original;
    local[0] = 8;
    int[] returned = edited(original);
    show("original", original);
    show("local", local);
    show("returned", returned);
    int[] inner = matrix[0];
    inner[0] = 9;
    io.println(matrix[0][0]);
    io.println(inner[0]);
    matrix[1][0] = 30;
    io.println(matrix[1][0]);

    io.println("destructure");
    int left, int right = [1, 2];
    const int kept, int open = [3, 4];
    int mutable, const int locked = [5, 6];
    io.println(left);
    io.println(right);
    io.println(kept);
    io.println(open);
    io.println(mutable);
    io.println(locked);

    io.println("iterate");
    loop (int value = empty.iter()) {
        io.println(value);
    }
    loop (int value = [4, 5, 6].iter()) {
        io.println(value);
    }
    loop (uint64 idx, int value = [7, 8].enumerate()) {
        io.println(f"{idx} - {value}");
    }
    loop (int value = fixed.iter()) {
        if (value == 20) {
            continue;
        }
        if (value == 30) {
            break;
        }
        io.println(value);
    }

    io.println("bounded");
    int[3] limited = [];
    limited.push(1);
    limited.push(2);
    limited.push(3);
    io.println(limited);
    int[2][1] grid = [[4, 5]];
    io.println(grid);
}
