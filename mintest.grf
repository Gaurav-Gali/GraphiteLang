import grf.io;

type User {
  name : auto str,
  age : auto int,
}

type Device {
  device : str,
}

void main() {
  Device d1 = {device : "laptop"};
  Device d2 = {device : "mobile"};
  User u1 = {name : "graphite", age : 21};
  
  map<str, Device[]> m = {
    u1.name : [
      d1, d2
    ],
  };

  io.println(m);

  try {
    auto int a = io.input(">> ");
    int b = a / 0;
  } catch(DivisionByZeroError err) {
    io.println(err.kind());
  } catch(Error err) {
    io.println(err.message());
  }
}

