import grf.io;
import grf.time;

async<void> main() {
  int[] arr = [1,2,3,4,5,6];

  array a = new array(arr);

  loop(await<int> i : a.delay(0.5)) io.println(i);
}

class array {
  int[] arr;

  array(int[] arr) this.arr = arr;

  asyncIter<int> delay(auto flt _time = 0.1) {
    loop(int i : this.arr) {
      await time.sleep(time.secs(_time));
      emit i;
    }
  }
}