import grf.io.log;
import grf.time;

type log_type {
    duration: auto flt,
    error: str
}

async<void> main() {
    loop(int i : range(5)) {
      await time.sleep(time.secs(1));

      log.warn<log_type>(
        "Operation failed",
        {
            duration: i+1,
            error: "log failed"
        },
        save_to="./test.csv"
    );
    }

}
