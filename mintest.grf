import grf.io;
import grf.time;

async<void> main() {
  flt start = time.flt();
  loop(await<str> i : delay<str>("graphite version 1.0".split(""), 0.01)) {
    io.print(i);
  }
  flt end = time.flt();

  io.println(f"\n{time.toSecs(end-start)}");
}

asyncIter<T> delay<T>(T[] arr, flt dial=1) {
  loop (T i : arr) {
    await time.sleep(time.secs(dial));
    emit i;
  }
}
