import grf.io;

void main() {
  auto int n = io.input("n >>> ");
  int[] arr;

  loop(int i = 0; i < n; i++) {
    arr[i] = int(io.input(">>> "));
  }

  arr = array.forEach(arr, int (int x) {
    if(x%2 == 0) return x**2;
    return x;
  });

  io.println(arr);
}

class array {
  @static
  int[] forEach(int[] arr, int fn(int x)) {
    loop(int i = 0; i < lengthOf(arr); i++) {
      arr[i] = fn(arr[i]);
    }

    return arr;
  }
}